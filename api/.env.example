# ASAAS Agents API Configuration Example
# Copy to .env and adjust values as needed. No secrets should be placed here.

APP_NAME="ASAAS Agents API"
ENVIRONMENT=development
DEBUG=false
HOST=127.0.0.1
PORT=8000
DATABASE_PATH=./data/app.db
MAX_REQUEST_SIZE_BYTES=10485760
# Comma-separated list of allowed origins, or JSON array e.g. ["https://agents.ai-asaas.com"]
ALLOWED_ORIGINS=[]
WEB_DIST_PATH=../web/dist
