    "expected_improvement": "\u0627\u0646\u062e\u0641\u0627\u0636 \u0645\u0639\u062f\u0644 \u062a\u0641\u0627\u0639\u0644 \u0627\u0644\u0632\u0648\u0627\u0631 \u0648\u0636\u064a\u0627\u0639 \u0641\u0631\u0635 \u0627\u0644\u062a\u062d\u0648\u064a\u0644 \u0644\u0639\u062f\u0645 \u0648\u0636\u0648\u062d \u0627\u0644\u062e\u0637\u0648\u0629 \u0627\u0644\u062a\u0627\u0644\u064a\u0629.",
    "estimated_effort": "small",
